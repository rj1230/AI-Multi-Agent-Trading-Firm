"""
Portfolio Ledger
================

Persistent local portfolio state used by the trading system.

Design principles:

1. The ledger is the local portfolio source of truth.
2. Successful broker fills are the only events that mutate positions.
3. A fresh backtest must be explicitly isolated from previous state.
4. Live/paper operation may continue loading an existing ledger.
5. Backtests should pass fresh=True so an old ledger file can never leak
   positions or cash into a new simulation.
"""

from __future__ import annotations

import json
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

from portfolio.state import (
    PortfolioSnapshot,
    Position,
    build_correlation_matrix,
)


DEFAULT_LEDGER_PATH = Path("portfolio") / "portfolio_ledger.json"


class PortfolioLedger:
    """
    Local portfolio state store.

    Parameters
    ----------
    starting_equity:
        Initial portfolio equity/cash for a new ledger.

    path:
        JSON persistence path.

    fresh:
        When True, always initialize a completely new portfolio state,
        regardless of whether the persistence file already exists.

        This is required for isolated backtests.

        When False, an existing ledger is loaded if present.
    """

    def __init__(
        self,
        starting_equity: float,
        path: Path = DEFAULT_LEDGER_PATH,
        *,
        fresh: bool = False,
    ):
        if starting_equity <= 0:
            raise ValueError("starting_equity must be greater than zero.")

        self.path = Path(path)
        self.starting_equity = float(starting_equity)
        self.simulated_date: datetime | None = None

        if fresh:
            self._data = self._fresh_state()
            self._save(self._data)
        else:
            self._data = self._load_or_init()

    # ------------------------------------------------------------------
    # State initialization
    # ------------------------------------------------------------------

    def _fresh_state(self) -> dict[str, Any]:
        """
        Create a completely isolated portfolio state.

        This is deliberately independent of whatever may already exist
        at self.path.
        """
        return {
            "cash": self.starting_equity,
            "positions": {},
            "session_date": None,
            "session_starting_equity": self.starting_equity,
        }

    def _load_or_init(self) -> dict[str, Any]:
        """
        Load an existing ledger or initialize a new one.

        This behavior is appropriate for persistent paper/live state.

        Backtests should use fresh=True instead.
        """
        if self.path.exists():
            try:
                data = json.loads(
                    self.path.read_text(
                        encoding="utf-8",
                    )
                )

                if not isinstance(data, dict):
                    raise ValueError("Ledger JSON root must be an object.")

                data.setdefault(
                    "cash",
                    self.starting_equity,
                )
                data.setdefault(
                    "positions",
                    {},
                )
                data.setdefault(
                    "session_date",
                    None,
                )
                data.setdefault(
                    "session_starting_equity",
                    self.starting_equity,
                )

                return data

            except (OSError, json.JSONDecodeError, ValueError) as exc:
                raise RuntimeError(
                    f"Unable to load portfolio ledger from {self.path}: {exc}"
                ) from exc

        data = self._fresh_state()
        self._save(data)

        return data

    # ------------------------------------------------------------------
    # Persistence
    # ------------------------------------------------------------------

    def _save(self, data: dict[str, Any] | None = None) -> None:
        """
        Persist the current ledger atomically enough for local usage.
        """
        if data is None:
            data = self._data

        self.path.parent.mkdir(
            parents=True,
            exist_ok=True,
        )

        self.path.write_text(
            json.dumps(
                data,
                indent=2,
                default=str,
            ),
            encoding="utf-8",
        )

    # ------------------------------------------------------------------
    # Simulation clock
    # ------------------------------------------------------------------

    def set_simulated_date(
        self,
        simulated_date: datetime | None,
    ) -> None:
        """
        Set the historical simulation timestamp.

        The backtest runner uses this so mark-to-market operations and
        correlation calculations can operate against the simulated clock.
        """
        if simulated_date is None:
            self.simulated_date = None
            return

        if simulated_date.tzinfo is None:
            simulated_date = simulated_date.replace(
                tzinfo=timezone.utc,
            )

        self.simulated_date = simulated_date.astimezone(
            timezone.utc,
        )

    # ------------------------------------------------------------------
    # Internal helpers
    # ------------------------------------------------------------------

    def _current_timestamp(self) -> datetime:
        """
        Return the ledger's effective timestamp.
        """
        if self.simulated_date is not None:
            return self.simulated_date

        return datetime.now(timezone.utc)

    def _mark_to_market(self) -> None:
        """
        Mark stored positions to their latest available market value.

        The actual price source remains inside portfolio.state/data_sources;
        this method only keeps the persisted market value refreshed.
        """
        if not self._data.get("positions"):
            return

        positions = self._data["positions"]

        tickers = list(positions.keys())

        try:
            from data_sources import fetch_ohlcv
        except ImportError:
            return

        for ticker in tickers:
            position = positions.get(ticker)

            if not isinstance(position, dict):
                continue

            shares = float(
                position.get(
                    "shares",
                    0.0,
                )
            )

            if shares <= 0:
                continue

            try:
                series = fetch_ohlcv(
                    ticker,
                    lookback_days=1,
                )

                if series.is_empty or series.latest is None:
                    continue

                price = float(series.latest.close)

                position["market_value"] = shares * price

            except Exception:
                # Mark-to-market failure must not mutate the position
                # into an invalid state.
                continue

        self._save()

    # ------------------------------------------------------------------
    # Fill recording
    # ------------------------------------------------------------------

    def record_fill(
        self,
        ticker: str,
        side: str,
        qty: float,
        price: float,
        sector: str,
    ) -> None:
        """
        Record an actual broker fill.

        IMPORTANT:
        This method should only be called after the broker confirms that
        the order actually executed.

        Supported sides:

            buy
            sell
        """
        ticker = str(ticker).upper().strip()
        side = str(side).lower().strip()

        qty = float(qty)
        price = float(price)

        if not ticker:
            raise ValueError("ticker must not be empty.")

        if side not in {
            "buy",
            "sell",
        }:
            raise ValueError(f"Unsupported fill side: {side}")

        if qty <= 0:
            raise ValueError("qty must be greater than zero.")

        if price <= 0:
            raise ValueError("price must be greater than zero.")

        positions = self._data.setdefault(
            "positions",
            {},
        )

        if side == "buy":
            existing = positions.get(ticker)

            if existing is None:
                positions[ticker] = {
                    "ticker": ticker,
                    "shares": qty,
                    "sector": sector,
                    "market_value": qty * price,
                }

            else:
                old_shares = float(
                    existing.get(
                        "shares",
                        0.0,
                    )
                )

                old_market_value = float(
                    existing.get(
                        "market_value",
                        0.0,
                    )
                )

                old_price = old_market_value / old_shares if old_shares > 0 else price

                new_shares = old_shares + qty

                new_average_price = (
                    (old_shares * old_price) + (qty * price)
                ) / new_shares

                existing["ticker"] = ticker
                existing["shares"] = new_shares
                existing["sector"] = sector
                existing["market_value"] = new_shares * new_average_price

            self._data["cash"] = float(
                self._data.get(
                    "cash",
                    self.starting_equity,
                )
            ) - (qty * price)

        else:
            existing = positions.get(ticker)

            if existing is None:
                raise ValueError(f"Cannot sell {ticker}: no position exists.")

            existing_shares = float(
                existing.get(
                    "shares",
                    0.0,
                )
            )

            if qty > existing_shares + 1e-9:
                raise ValueError(
                    f"Cannot sell {qty} shares of "
                    f"{ticker}: only "
                    f"{existing_shares} shares held."
                )

            remaining = existing_shares - qty

            self._data["cash"] = float(
                self._data.get(
                    "cash",
                    self.starting_equity,
                )
            ) + (qty * price)

            if remaining <= 1e-9:
                positions.pop(
                    ticker,
                    None,
                )
            else:
                existing["shares"] = remaining
                existing["market_value"] = remaining * price

        self._data["session_date"] = self._current_timestamp().isoformat()

        self._save()

    # ------------------------------------------------------------------
    # Snapshot
    # ------------------------------------------------------------------

    def snapshot(self) -> PortfolioSnapshot:
        """
        Return the current portfolio snapshot.

        Equity =
            cash + marked-to-market position values.
        """
        self._mark_to_market()

        raw_positions = self._data.get(
            "positions",
            {},
        )

        positions: dict[str, Position] = {}

        total_market_value = 0.0

        for ticker, raw in raw_positions.items():
            shares = float(
                raw.get(
                    "shares",
                    0.0,
                )
            )

            if shares <= 0:
                continue

            market_value = float(
                raw.get(
                    "market_value",
                    0.0,
                )
            )

            sector = str(
                raw.get(
                    "sector",
                    "Unknown",
                )
            )

            positions[ticker] = Position(
                ticker=ticker,
                shares=shares,
                sector=sector,
                market_value=market_value,
            )

            total_market_value += market_value

        cash = float(
            self._data.get(
                "cash",
                self.starting_equity,
            )
        )

        equity = cash + total_market_value

        correlation_matrix = build_correlation_matrix(
            list(positions.keys()),
            lookback_days=30,
        )

        return PortfolioSnapshot(
            equity=equity,
            starting_equity=self.starting_equity,
            positions=positions,
            correlation_matrix=correlation_matrix,
        )

    # ------------------------------------------------------------------
    # Convenience accessors
    # ------------------------------------------------------------------

    def get_cash(self) -> float:
        """
        Return current cash.
        """
        return float(
            self._data.get(
                "cash",
                self.starting_equity,
            )
        )

    def get_positions(self) -> dict[str, dict[str, Any]]:
        """
        Return the raw position mapping.

        A shallow JSON-safe copy is returned so callers cannot mutate
        internal ledger state accidentally.
        """
        return json.loads(
            json.dumps(
                self._data.get(
                    "positions",
                    {},
                )
            )
        )

    def reset(self) -> None:
        """
        Explicitly reset this ledger to a fresh portfolio.

        Primarily useful for tests and controlled local workflows.
        """
        self._data = self._fresh_state()
        self._save(self._data)
